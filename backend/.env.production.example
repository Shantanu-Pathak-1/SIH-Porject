# ==============================================================================
# GeoAlert-NER — Production Environment Template (.env.production.example)
# INSTRUCTIONS:
# 1. Copy this file to '.env' on your production deployment host:
#    cp .env.production.example .env
# 2. Generate a secure 256-bit secret key using:
#    python scripts/generate_secret.py
# 3. Replace all 'YOUR_*' placeholders with actual production values.
# 4. NEVER commit the active '.env' file to version control.
# ==============================================================================

# ─── Database Configuration (PostgreSQL 14+ with PostGIS) ─────────────────────
# Async connection URL used by FastAPI and SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# Synchronous connection URL used by Alembic migrations and CLI sync tools (psycopg2 driver)
SYNC_DATABASE_URL=postgresql+psycopg2://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME

# ─── Security & Authentication ────────────────────────────────────────────────
# Cryptographic secret key for signing JWT bearer tokens (HS256)
# MANDATORY: Generate using: python scripts/generate_secret.py
SECRET_KEY=YOUR_CRYPTOGRAPHICALLY_SECURE_256BIT_SECRET_KEY

# Comma-separated list of allowed production frontend origins for CORS
# Example: https://geoalert.ner.gov.in,https://dashboard.geoalert.in
CORS_ORIGINS=https://YOUR_PRODUCTION_FRONTEND_DOMAIN

# ─── Cache & PubSub Broker (Redis) ───────────────────────────────────────────
# Optional: In-memory broadcast fallback is used automatically if Redis is absent.
# For multi-worker or multi-container deployments, set your Redis connection string:
REDIS_URL=redis://YOUR_REDIS_HOST:6379/0

# ─── Geospatial Reference System ─────────────────────────────────────────────
# Default Spatial Reference Identifier (WGS 84 GPS coordinates standard)
DEFAULT_SRID=4326

# ─── Landslide Geotechnical Risk Thresholds ──────────────────────────────────
# Thresholds calibrated for North Eastern Region (NER) Himalayan terrain
MOISTURE_CRITICAL_THRESHOLD=85.0
MOISTURE_HIGH_THRESHOLD=70.0
TILT_CRITICAL_THRESHOLD=5.0
RAINFALL_24H_CRITICAL=100.0

# ─── Automated Government Data Ingestion Intervals (Hours / Minutes) ──────────
RAINFALL_SYNC_INTERVAL_HOURS=6
NASA_GLC_SYNC_INTERVAL_HOURS=168
GSI_SYNC_INTERVAL_HOURS=720
RISK_EVAL_INTERVAL_MINUTES=60
SRTM_SLOPE_FILL_ON_STARTUP=True

# ─── External Government & Satellite REST Endpoints ──────────────────────────
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
NASA_GLC_API_URL=https://data.nasa.gov/resource/8vwt-rmac.json

# Geological Survey of India (GSI) Bhuvan WMS
GSI_BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
# Optional: Token for registered ISRO/GSI Bhuvan accounts (leave blank if unregistered)
GSI_BHUVAN_TOKEN=

# ─── North Eastern Region (NER) Spatial Bounding Box ─────────────────────────
NER_BBOX_MIN_LAT=21.0
NER_BBOX_MAX_LAT=29.5
NER_BBOX_MIN_LON=88.0
NER_BBOX_MAX_LON=97.5
