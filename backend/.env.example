DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geoalert_ner
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/geoalert_ner
REDIS_URL=redis://localhost:6379

# Scheduler Intervals
RAINFALL_SYNC_INTERVAL_HOURS=6
NASA_GLC_SYNC_INTERVAL_HOURS=168
GSI_SYNC_INTERVAL_HOURS=720
RISK_EVAL_INTERVAL_MINUTES=60
SRTM_SLOPE_FILL_ON_STARTUP=True

# Government API Config
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
NASA_GLC_API_URL=https://data.nasa.gov/resource/8vwt-rmac.json
GSI_BHUVAN_WMS_URL=https://bhuvan-vec1.nrsc.gov.in/bhuvan/wms
GSI_BHUVAN_TOKEN=

# JWT Secret — CHANGE THIS IN PRODUCTION!
SECRET_KEY=GEOALERT_NER_SECRET_CHANGE_IN_PROD
